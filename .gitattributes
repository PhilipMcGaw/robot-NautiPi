# Normalise text files to LF on commit
* text=auto eol=lf

# KiCad source files
*.kicad_pcb linguist-detectable=true
*.kicad_sch linguist-detectable=true
*.kicad_pro linguist-detectable=true

# KiCad generated or vendor material
fp-info-cache linguist-generated=true
*.kicad_prl linguist-generated=true
**/*.pretty/** linguist-vendored=true

# Binary CAD, manufacturing, media, and archive files
*.3mf binary
*.7z binary
*.dwg binary
*.dxf binary
*.gif binary
*.jpeg binary
*.jpg binary
*.mp4 binary
*.pdf binary
*.png binary
*.pptx binary
*.stl binary
*.step binary
*.stp binary
*.webp binary
*.xlsx binary
*.zip binary